      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка действия"
          }
        }
      }
    },
    "Action Button Setup": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка кнопки действия"
          }
        }
      }
    },
    "Add **Translate Screenshot for Quick Look**. Search for “ChinaTap” to find it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте **Перевести скриншот для просмотра** — найдите его поиском по «ChinaTap»."
          }
        }
      }
    },
    "Add **Translate Screenshot in App**. Search for “ChinaTap” to find it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте **Перевести скриншот в приложении** — найдите его поиском по «ChinaTap»."
          }
        }
      }
    },
