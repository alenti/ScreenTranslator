      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Китайский"
          }
        }
      }
    },
    "Chinese text is translated privately on this iPhone.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Китайский текст переводится конфиденциально, прямо на этом iPhone."
          }
        }
      }
    },
    "Chinese text will be translated into this language. You can change it any time.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Китайский текст будет переводиться на этот язык. Его можно сменить в любой момент."
          }
        }
      }
    },
    "Chinese → %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Китайский → %@"
          }
        }
      }
    },
