      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить готовую команду"
          }
        }
      }
    },
    "Add the **Quick Look** action.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте действие **Быстро просмотреть**."
