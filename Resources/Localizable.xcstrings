      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите язык"
          }
        }
      }
    },
    "Choose “%@.gguf” in Files. The file is checked before it is installed.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «%@.gguf» в Файлах. Перед установкой файл будет проверен."
