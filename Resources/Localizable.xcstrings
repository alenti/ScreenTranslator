    "About": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О приложении"
          }
        }
      }
    },
    "Accepts a screenshot from Shortcuts and returns a PNG file for the Shortcuts Quick Look action.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принимает скриншот из Быстрых команд и возвращает PNG для действия «Быстро просмотреть»."
          }
        }
      }
    },
    "Acknowledgements": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Благодарности"
          }
        }
      }
    },
